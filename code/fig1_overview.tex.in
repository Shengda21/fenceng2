% ------------------------------------------------------------------ panel a
\node[ptitle] at (0,5.35) {\textbf{a}\hspace{4pt}The practice: a model in the slot};
% the two inputs, each led by its glyph: a speech bubble for the briefing, an eye for the observation
\node[box, fill=ogobs, draw=ogobsb, dashed, minimum width=1.62cm, align=left, font=\sffamily\fontsize{7}{7.9}\selectfont] (b) at (0.78,4.62) {\hspace*{3.1mm}Scouting\\\hspace*{3.1mm}briefing\\\hspace*{3.1mm}in words};
\node[box, fill=ogobs, draw=ogobsb, minimum width=2.02cm, align=left, font=\sffamily\fontsize{7}{7.9}\selectfont] (o) at (2.91,4.62) {\hspace*{3.1mm}Observation\\\hspace*{3.1mm}$o$ of other\\\hspace*{3.1mm}agents};
\pic at ([xshift=1.9mm]b.west) {gl-bubble};
\pic at ([xshift=1.9mm]o.west) {gl-eye};
\node[box, fill=ogrouter, draw=ogrouterb, line width=1.0pt, minimum height=1.4cm] (r) at (2.0,3.05) {};
\node[anchor=north, inner sep=2.5pt] at (r.north) {\textbf{selector slot}};
\node[chip] (c1) at (0.85,2.8) {fixed $\tau$};
\node[chip] (c2) at (2.0,2.8) {learner};
\node[chip, draw=ogrouterb, fill=ogrouterb, text=white] (c3) at (3.15,2.8) {\textbf{LLM}};
% what fills the slot: a pinned strategy, a bandit's lever, a language model's chip
\pic at (0.85,3.21) {gl-pin};
\pic at (2.0,3.21) {gl-lever};
\pic at (3.15,3.21) {gl-chip};
\node[box, fill=ogpool, draw=ogpoolb] (p) at (2.0,1.75) {Strategy pool $\mathcal{T}_D$\\finite, typed};
\node[box, fill=ogsolver, draw=ogsolverb] (s) at (2.0,0.9) {Executor, I1--I4};
\node[box, fill=ogobs, draw=ogobsb] (e) at (2.0,0.1) {Environment step};
\draw[wire] (b.south) -- (b.south |- r.north);
\draw[wire] (o.south) -- (o.south |- r.north) node[midway,right=1pt,lbl]{$\mathrm{enc}(o)$};
\draw[wire] (r)--(p) node[midway,right=1pt,lbl]{$\tau$};
\draw[wire] (p)--(s) node[midway,right=1pt,lbl]{$(\tau,o)$};
\draw[wire] (s)--(e) node[midway,right=1pt,lbl]{$a$};
\draw[wire] (e.east) -- ++(0.45,0) |- (o.east);
\node[lbl, rotate=90] at (4.5,2.55) {type $\theta$ drawn per episode, unobserved};
% ------------------------------------------------------------------ panel b
\begin{scope}[xshift=-0.35cm]
\node[ptitle] at (5.2,5.35) {\textbf{b}\hspace{4pt}What caps any selector, model or not};
\node[rounded corners=2pt, fill=black!5, draw=black!25, line width=0.4pt, inner sep=3pt, font=\sffamily\small] at (8.15,4.65)
  {$V_D(\Pi)-\Vstar=\,{\color{ogheadroom}\HD}\,-\,\mathbb{E}[\rho]$};
% three bars, 0.62 wide with gaps of 0.85: a model that reads the type and a cheap selector that reads it both
% reach the ceiling but for a small regret; a selector that misreads it ends below the best fixed strategy. The
% headroom arrow stands right of the bars, beside the labels of the two lines it spans.
\begin{scope}[yscale=0.8, yshift=-0.55cm]
\draw[->, line width=0.6pt, black!70] (5.75,0.95) -- (5.75,4.85);
\draw[line width=0.5pt, black!60] (5.75,0.95) -- (9.9,0.95);
\draw[line width=0.6pt, black!55] (5.75,2.5) -- (9.9,2.5);
\draw[ceil] (5.75,4.15) -- (9.9,4.15);
\draw[<->, line width=0.9pt, draw=ogheadroom] (9.72,2.5) -- (9.72,4.15);
\filldraw[fill=black!22, draw=black!70, line width=0.5pt] (5.95,0.95) rectangle (6.57,3.75);
\filldraw[hatchfill] (5.95,3.75) rectangle (6.57,4.15);
\filldraw[fill=black!22, draw=black!70, line width=0.5pt] (7.42,0.95) rectangle (8.04,3.75);
\filldraw[hatchfill] (7.42,3.75) rectangle (8.04,4.15);
\filldraw[fill=black!22, draw=black!70, line width=0.5pt] (8.89,0.95) rectangle (9.51,1.85);
\filldraw[hatchfill] (8.89,1.85) rectangle (9.51,4.15);
\draw[white, line width=2.6pt] (6.21,2.5) -- (6.21,3.75);
\draw[{Circle[length=2.2pt]}-{Stealth[length=4.2pt,width=4pt]}, line width=1pt, black] (6.21,2.5) -- (6.21,3.75);
\draw[white, line width=2.6pt] (7.68,2.5) -- (7.68,3.75);
\draw[{Circle[length=2.2pt]}-{Stealth[length=4.2pt,width=4pt]}, line width=1pt, black] (7.68,2.5) -- (7.68,3.75);
\draw[white, line width=2.6pt] (9.15,2.5) -- (9.15,1.85);
\draw[{Circle[length=2.2pt]}-{Stealth[length=4.2pt,width=4pt]}, line width=1pt, black] (9.15,2.5) -- (9.15,1.85);
