\node[anchor=west, text=ogheadroom, inner sep=1pt] at (9.83,2.55) {$\HD$};
\node[anchor=west, inner sep=0.5pt, font=\sffamily\small\bfseries] at (6.27,2.06) {$\pmb{+}$};
\node[anchor=west, inner sep=0.5pt, font=\sffamily\small\bfseries] at (7.74,2.06) {$\pmb{+}$};
\node[anchor=west, inner sep=0.5pt, fill=white, font=\sffamily\small\bfseries] at (9.19,1.3) {$\pmb{-}$};
\node[align=center, lbl, anchor=north] at (6.26,0.16) {model\\reads};
\node[align=center, lbl, anchor=north] at (7.73,0.16) {cheap selector\\reads};
