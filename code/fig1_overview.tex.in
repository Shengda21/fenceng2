% ------------------------------------------------------------------ panel c
\node[ptitle] at (10.92,5.35) {\textbf{c}\hspace{4pt}The diagnostic: mechanism and prediction};
% the funnel: three stages on one axis, each 3 mm narrower per side than the one above, read top down; a stage that
% fails exits to the right
\begin{scope}[
  stage/.style={rounded corners=2pt, draw=black!70, fill=white, line width=0.6pt, minimum height=0.74cm, inner sep=0pt},
  exitbox/.style={rounded corners=2pt, draw=black!30, fill=black!4, line width=0.4pt, text=black!60, align=center,
    font=\sffamily\fontsize{7}{7.8}\selectfont, minimum width=1.80cm, minimum height=0.62cm, inner sep=1.5pt},
  exitwire/.style={->, line width=0.6pt, draw=black!40},
  qtext/.style={anchor=north west, inner sep=0pt, text=black!75, font=\sffamily\fontsize{7}{7.8}\selectfont}]
\foreach \y/\bwid/\tag/\name/\q/\ex in {
  4.78/4.82/C1/Headroom/{Is there something to read?}/{use the best\\fixed strategy},
  3.76/4.22/C2/Legibility/{Does the model read it?}/{this model is\\not useful here},
  2.74/3.62/C3/Comparative advantage/{Is it ahead of cheaper readers?}/{use the cheaper\\selector}}{
  \node[stage, minimum width=\bwid cm] (s\tag) at (13.33,\y) {};
  \node[badge, anchor=north west] at ([xshift=1.3mm,yshift=-1.0mm]s\tag.north west) {\tag};
  \node[anchor=west, inner sep=0pt] at ([xshift=7.2mm,yshift=-2.75mm]s\tag.north west) {\textbf{\name}};
  \node[qtext] at ([xshift=1.3mm,yshift=-5.0mm]s\tag.north west) {\q};
  \node[exitbox] (x\tag) at (17.02,\y) {\ex};
  \draw[exitwire] (s\tag.east) -- (x\tag.west) node[midway, above=0.3pt, lbl, text=black!55] {no};
}
\node[rounded corners=2pt, draw=ogrouterb, fill=ogrouterb, text=white, line width=0.6pt, minimum width=2.6cm,
  minimum height=0.44cm, inner sep=1pt, font=\sffamily\bfseries\scriptsize] (pay) at (13.33,1.89) {the LLM can pay};
\draw[wire] (sC1.south) -- (sC2.north) node[midway, right=1pt, lbl] {yes};
\draw[wire] (sC2.south) -- (sC3.north) node[midway, right=1pt, lbl] {yes};
\draw[wire] (sC3.south) -- (pay.north) node[midway, right=1pt, lbl] {yes};
\end{scope}
% the three tested regimes, in a box of their own below a gap and under a heading; glyphs: the games of the
% first-moves cells, the briefing, known or new agents
\node[anchor=north west, rounded corners=2pt, fill=black!5, draw=black!25, line width=0.4pt, minimum width=6.47cm,
  minimum height=2.27cm, inner sep=0pt] at (11.45,1.45) {};
\node[anchor=north west, inner sep=0pt, text=black!65, font=\sffamily\itshape\fontsize{7}{7.8}\selectfont]
  at (11.63,1.36) {Predicted gate and where the tested regimes land};
\begin{scope}[rg/.style={anchor=north west, inner sep=0pt, text width=5.4cm, align=left,
  font=\sffamily\fontsize{7}{7.8}\selectfont, execute at begin node={\hyphenpenalty=10000\relax}}, gl size=2.3mm]
\node[rg] at (12.37,1.02) {\textbf{First moves:} C2 closes in battle, C3 elsewhere $\rightarrow$ no LLM win};
\pic at (11.63,0.89) {gl-battle}; \pic at (11.89,0.89) {gl-combined}; \pic at (12.15,0.89) {gl-rps};
\node[rg] at (12.37,0.40) {\textbf{Briefing, mostly known:} C3 closes $\rightarrow$ a cheap text reader suffices};
\pic at (11.63,0.27) {gl-bubble}; \pic at (11.89,0.27) {gl-known};
\node[rg] at (12.37,-0.22) {\textbf{Briefing, held-out compositions:} C3 sometimes stays open $\rightarrow$ an LLM can pay};
\pic at (11.63,-0.35) {gl-bubble}; \pic at (11.89,-0.35) {gl-new};
\end{scope}
\end{tikzpicture}
